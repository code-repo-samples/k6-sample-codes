{
  "name": "coke-codes-ui-automation",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:flow": "playwright test tests/all-flows.spec.js --grep",
    "test:flow:all": "playwright test tests/all-flows.spec.js",
    "test:flow:organization": "playwright test tests/all-flows.spec.js --grep \"@organization\"",
    "test:flow:realtime": "playwright test tests/all-flows.spec.js --grep \"@realtime\"",
    "test:flow:validate": "playwright test tests/all-flows.spec.js --grep \"@validate\"",
    "test:flow:program": "playwright test tests/all-flows.spec.js --grep \"@program\"",
    "test:flow:program-release": "playwright test tests/all-flows.spec.js --grep \"@program|@release\"",
    "test:flow:program-campaign": "playwright test tests/all-flows.spec.js --grep \"@program|@campaign\"",
    "test:flow:closurematrix": "playwright test tests/all-flows.spec.js --grep \"@closurematrix\"",
    "test:flow:download": "playwright test tests/all-flows.spec.js --grep \"@download\"",
    "test:flow:gpg": "playwright test tests/all-flows.spec.js --grep \"@gpg\"",
    "test:negative": "playwright test tests/negative-cases.spec.js",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "report:dashboard": "node scripts/generate-report.js",
    "test:all": "npm test; npm run report:dashboard",
    "codegen": "playwright codegen https://ui-gcp.alpha.codes.coke.com/programs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "dotenv": "^16.4.5"
  }
}
